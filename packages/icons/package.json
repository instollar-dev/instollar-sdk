{
  "name": "@instollar-dev/icons",
  "version": "1.1.0",
  "description": "Curated Iconsax icons for Instollar web and native apps",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/instollar-dev/instollar-sdk.git",
    "directory": "packages/icons"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "import": "./dist/web/index.mjs",
      "require": "./dist/web/index.js"
    },
    "./native": {
      "types": "./dist/native/index.d.ts",
      "import": "./dist/native/index.mjs",
      "require": "./dist/native/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepare": "node -e \"const p=require('path');if(p.resolve(process.env.INIT_CWD||'')!==p.resolve(process.cwd())){require('child_process').execSync('npm run build',{stdio:'inherit'})}\""
  },
  "license": "MIT",
  "dependencies": {
    "iconsax-react": "^0.0.8"
  },
  "peerDependencies": {
    "iconsax-react-nativejs": "^0.0.8",
    "react": ">=18.0.0",
    "react-native": ">=0.72.0",
    "react-native-svg": ">=13.0.0"
  },
  "peerDependenciesMeta": {
    "iconsax-react-nativejs": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "iconsax-react-nativejs": "^0.0.8",
    "react": "^18.2.0",
    "react-native": "^0.73.0",
    "react-native-svg": "^14.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
