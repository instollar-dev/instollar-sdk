{
  "name": "@instollar-dev/ui-native",
  "version": "1.1.0",
  "description": "React Native UI components for Instollar Expo apps",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/instollar-dev/instollar-sdk.git",
    "directory": "packages/ui-native"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepare": "node -e \"const p=require('path');if(p.resolve(process.env.INIT_CWD||'')!==p.resolve(process.cwd())){require('child_process').execSync('npm run build',{stdio:'inherit'})}\""
  },
  "license": "MIT",
  "dependencies": {
    "@instollar-dev/tokens": "file:../tokens"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.72.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "react": "^18.2.0",
    "react-native": "^0.73.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
