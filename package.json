{
  "name": "instollar-sdk",
  "version": "1.1.0",
  "description": "SDK for Instollar - React (web) and Expo apps",
  "workspaces": [
    "packages/*"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/core/api/index.d.ts",
      "import": "./dist/core/api/index.mjs",
      "require": "./dist/core/api/index.js"
    },
    "./storage": {
      "types": "./dist/core/storage/index.d.ts",
      "import": "./dist/core/storage/index.mjs",
      "require": "./dist/core/storage/index.js"
    },
    "./socket": {
      "types": "./dist/core/socket/index.d.ts",
      "import": "./dist/core/socket/index.mjs",
      "require": "./dist/core/socket/index.js"
    },
    "./toast": {
      "types": "./dist/core/toast/index.d.ts",
      "import": "./dist/core/toast/index.mjs",
      "require": "./dist/core/toast/index.js"
    },
    "./countries": {
      "types": "./dist/core/app/countries/index.d.ts",
      "import": "./dist/core/app/countries/index.mjs",
      "require": "./dist/core/app/countries/index.js"
    },
    "./languages": {
      "types": "./dist/core/app/languages/index.d.ts",
      "import": "./dist/core/app/languages/index.mjs",
      "require": "./dist/core/app/languages/index.js"
    },
    "./styles.css": "./packages/ui-web/dist/styles.css",
    "./tailwind.config": "./packages/ui-web/tailwind.config.ts"
  },
  "files": [
    "dist",
    "packages/tokens/dist",
    "packages/ui-web/dist",
    "packages/ui-web/tailwind.config.ts",
    "packages/icons/dist",
    "README.md",
    ".npmrc.example"
  ],
  "scripts": {
    "build": "tsup",
    "build:packages": "npm run build -w @instollar-dev/tokens && npm run build -w @instollar-dev/tailwind-preset && npm run build -w @instollar-dev/icons && npm run build -w @instollar-dev/ui-web && npm run build -w @instollar-dev/ui-native",
    "build:all": "npm run build && npm run build:packages",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "clean": "rm -rf dist && npm run clean --workspaces --if-present",
    "prepare": "npm run build:all"
  },
  "keywords": [
    "instollar",
    "sdk",
    "api",
    "react",
    "expo",
    "cross-platform"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/instollar-dev/instollar-sdk.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "@instollar-dev/icons": "1.1.0",
    "@instollar-dev/tokens": "1.1.0",
    "@instollar-dev/ui-web": "1.1.0",
    "axios": "^1.6.0",
    "iconsax-react": "^0.0.8",
    "socket.io-client": "^4.8.3"
  },
  "peerDependencies": {
    "expo-secure-store": ">=10.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "expo-secure-store": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "country-state-city": "^3.2.1",
    "expo-secure-store": "^12.0.0",
    "nigerian-states-and-lgas": "^1.0.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
